# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Relative Pfade werden gegen das Verzeichnis aufgelöst, aus dem der Befehl gestartet wurde
# (pnpm setzt INIT_CWD auf das Aufrufverzeichnis; Fallback: aktuelles Arbeitsverzeichnis).
DATABASE_PATH=./data/orchestrator.db
DATA_DIR=./data

# --- Linear (lesender Import; Statusänderungen nie, optional nur Abschlusskommentar) ---
LINEAR_API_KEY=
LINEAR_WRITE_COMMENTS=false

# --- Defaults für neue Projekte (Projekte werden pro Repository in der UI konfiguriert) ---
REPO_ROOT=
WORKTREE_ROOT=
BASE_BRANCH=main
GIT_AUTHOR_NAME=Robert Schreiner
GIT_AUTHOR_EMAIL=robsch@stagedates.com

# --- Agenten-CLIs ---
CLAUDE_BIN=claude
CODEX_BIN=codex
# OS-Sandbox für Projektbefehle (Dependency liefert die lokale CLI)
SRT_BIN=srt
# Optional: Modell-Overrides; leer = CLI-Default
# Defaults: Claude Opus 4.8 (alias `opus`) and Codex gpt-5.6-sol; leer = CLI-Default
CLAUDE_MODEL=claude-opus-5
CODEX_MODEL=gpt-5.6-sol
CLAUDE_EFFORT=high
CODEX_EFFORT=medium
# Optional: Kostenlimit pro Claude-Aufruf in USD (leer = kein Limit)
CLAUDE_MAX_BUDGET_USD=
# Agent für Implementierung und Nacharbeit: codex oder claude
IMPLEMENTATION_AGENT=codex

# --- Optionaler Token-Sparproxy (Headroom) ---
# Roh-Bins bleiben (kein `headroom wrap`): Wrapping würde MCP-Server injizieren
# und User-Config mutieren und damit die Sandbox-Härtung aus ADR-015 brechen.
# Stattdessen ein langlebiger `headroom proxy` und diese Base-URLs — der Traffic
# wird transparent auf HTTP-Ebene komprimiert. Beide Variablen werden an die
# jeweilige Agenten-CLI durchgereicht (siehe packages/agents/src/env.ts).
# WICHTIG: Proxy-Port != orchestrator PORT (8787), sonst Bind-Konflikt.
#   headroom proxy --port 8799
# ANTHROPIC_BASE_URL=http://127.0.0.1:8799
# OPENAI_BASE_URL=http://127.0.0.1:8799

# --- Workflow-Limits ---
MAX_REVIEW_LOOPS=3
MAX_JOB_RUNTIME_MINUTES=60
MAX_AGENT_OUTPUT_MB=10
MAX_CONCURRENT_JOBS=1
TEST_COMMAND_TIMEOUT_MINUTES=10

# --- Logging ---
LOG_LEVEL=info
